NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
STORAGE_BUCKET_NAME=audio

# Pesapal: use separate credentials for sandbox and live.
# Register https://YOUR-DOMAIN/api/payments/pesapal/ipn with Pesapal and copy its IPN ID below.
# Keep all credentials server-side; never prefix them with NEXT_PUBLIC_.
PESAPAL_ENVIRONMENT=sandbox
PESAPAL_SANDBOX_CONSUMER_KEY=
PESAPAL_SANDBOX_CONSUMER_SECRET=
PESAPAL_SANDBOX_IPN_ID=
PESAPAL_LIVE_CONSUMER_KEY=
PESAPAL_LIVE_CONSUMER_SECRET=
PESAPAL_LIVE_IPN_ID=
